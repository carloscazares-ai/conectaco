{
  "info": {
    "name": "conectaco",
    "description": "Pruebas de los endpoints de conectaco. Requiere la app corriendo en localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "GET hola",
      "request": { "method": "GET", "url": "{{baseUrl}}/test/hola" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Responde hola', () => pm.expect(pm.response.text()).to.eql('hola desde springboot'));"
      ] } }]
    },
    {
      "name": "GET carlos",
      "request": { "method": "GET", "url": "{{baseUrl}}/test/carlos" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Responde Carlos', () => pm.expect(pm.response.text()).to.eql('Hola desde el endpoint de Carlos'));"
      ] } }]
    },
    {
      "name": "GET yaretzi",
      "request": { "method": "GET", "url": "{{baseUrl}}/test/yaretzi" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Responde Yaretzi', () => pm.expect(pm.response.text()).to.eql('Hola desde el endpoint de Yaretzi'));"
      ] } }]
    },
    {
      "name": "POST usuario turista",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/usuarios",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Carlos\",\n  \"email\": \"carlos{{$timestamp}}@test.com\",\n  \"password\": \"Conectaco#2026\",\n  \"tipoUsuario\": \"Turista\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const u = pm.response.json();",
        "pm.test('Se genero el id', () => pm.expect(u.idUsuario).to.be.a('number'));",
        "pm.test('Se guardo la fecha de registro', () => pm.expect(u.fechaRegistro).to.be.a('string'));",
        "pm.test('Tipo Turista', () => pm.expect(u.tipoUsuario).to.eql('Turista'));"
      ] } }]
    },
    {
      "name": "POST usuario negocio",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/usuarios",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Tacos El Guero\",\n  \"email\": \"negocio{{$timestamp}}@test.com\",\n  \"password\": \"TacosGuero$1\",\n  \"tipoUsuario\": \"Negocio\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Tipo Negocio', () => pm.expect(pm.response.json().tipoUsuario).to.eql('Negocio'));"
      ] } }]
    },
    {
      "name": "GET usuarios",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/usuarios" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Regresa una lista con usuarios', () => pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty);"
      ] } }]
    },
    {
      "name": "CRUD 1 · POST crear Sandra",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/usuarios",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Sandra Olivares\",\n  \"email\": \"sandra{{$timestamp}}@test.com\",\n  \"password\": \"Sandra#2026\",\n  \"tipoUsuario\": \"Turista\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('idUsuario', pm.response.json().idUsuario);",
        "pm.collectionVariables.set('emailSandra', pm.response.json().email);"
      ] } }]
    },
    {
      "name": "CRUD 2 · GET por id",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/usuarios/{{idUsuario}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Es Sandra', () => pm.expect(pm.response.json().nombre).to.eql('Sandra Olivares'));"
      ] } }]
    },
    {
      "name": "CRUD 3 · GET por nombre y tipo",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/usuarios?nombre=olivares&tipoUsuario=Turista" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Todos se llaman Olivares y son turistas', () => pm.response.json().forEach(u => { pm.expect(u.nombre.toLowerCase()).to.include('olivares'); pm.expect(u.tipoUsuario).to.eql('Turista'); }));"
      ] } }]
    },
    {
      "name": "CRUD 4 · PATCH cambiar solo el nombre",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/usuarios/{{idUsuario}}",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Sandra Olivares Ruiz\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Cambió el nombre', () => pm.expect(pm.response.json().nombre).to.eql('Sandra Olivares Ruiz'));",
        "pm.test('El email sigue igual', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('emailSandra')));"
      ] } }]
    },
    {
      "name": "CRUD 5 · PUT reemplazar todo",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/usuarios/{{idUsuario}}",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Sandra Olivares\",\n  \"email\": \"sandra.nueva{{$timestamp}}@test.com\",\n  \"password\": \"Nueva#2026\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Cambió el email', () => pm.expect(pm.response.json().email).to.include('sandra.nueva'));"
      ] } }]
    },
    {
      "name": "CRUD 6 · DELETE borrar",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/v1/usuarios/{{idUsuario}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 204', () => pm.response.to.have.status(204));"
      ] } }]
    },
    {
      "name": "CRUD 7 · GET ya no existe",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/usuarios/{{idUsuario}}" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 404', () => pm.response.to.have.status(404));"
      ] } }]
    },
    {
      "name": "POST contraseña débil (debe fallar)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/usuarios",
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Débil\",\n  \"email\": \"debil{{$timestamp}}@test.com\",\n  \"password\": \"1234\",\n  \"tipoUsuario\": \"Turista\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 400', () => pm.response.to.have.status(400));",
        "pm.test('Explica qué le falta a la contraseña', () => pm.expect(pm.response.json().error).to.include('mayuscula'));"
      ] } }]
    },
    {
      "name": "GET turistas",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/turistas" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Cada turista apunta a un usuario', () => pm.response.json().forEach(t => pm.expect(t.idUsuario).to.be.a('number')));"
      ] } }]
    },
    {
      "name": "GET negocios",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/negocios" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Cada negocio apunta a un usuario', () => pm.response.json().forEach(n => pm.expect(n.idUsuario).to.be.a('number')));"
      ] } }]
    }
  ]
}
